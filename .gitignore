# Generated by Cargo
/target/
**/*.rs.bk

# IDEs and Editors
.idea/
*.iml
.vscode/

# Environment and configuration variables
.env
.env.local
*.env

# Operating System files
.DS_Store
Thumbs.db

# The wire contracts, fetched by bin/sync-contracts at a pinned commit. Never committed: a copy
# of a contract in a service repository is the exact thing kinetix-contracts exists to remove,
# and S9's exit criterion counts tracked .proto files.
/.contracts/
