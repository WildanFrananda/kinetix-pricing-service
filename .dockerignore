# Keep secrets and local state out of the build context (P0-IMG-01).
# Without this, COPY bakes .env — which holds rotated credentials — and the whole .git
# history into distributable image layers. `docker history` exposes them even if a later
# layer deletes the file.

.env
.env.*
!.env.example
*.pem
*.key

.git
.gitignore
.github
.gitlab-ci.yml

Dockerfile
compose*.yaml
docker-compose*.yml
.dockerignore

*.md
docs/

# Build output: rebuilt inside the image, and a host target/ is a different libc.
target/
tests/
.vscode/
